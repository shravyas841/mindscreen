# MindScreen Environment Configuration
# Copy this file to .env and fill in the values

# ── Database ────────────────────────────────────────────────────────────────
# For local development, this will default to SQLite automatically.
# For Render.com deployment, paste your Render PostgreSQL connection string here.
DATABASE_URL=postgresql://user:password@host:5432/mindscreen_db

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ── CORS / Frontend URL ───────────────────────────────────────────────────────
# For local dev: http://localhost:5173
# For production (Vercel): https://mindscreen.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# Support resources shown by the API
CRISIS_HELPLINE_1=Tele-MANAS: 14416 or 1-800-891-4416 (free, 24/7)
CRISIS_HELPLINE_2=iCall (TISS): 9152987821
